// Helper for test_drop_same_named_types.jam: this module's own `A` with a
// free `cfn drop`, and a test named like one in mod_drop_same_b.jam.
pub const A = struct { sink: *mut i64 };
cfn drop(self: mut A) { var p: *mut i64 = self.sink; p.* = p.* + 1; }
pub fn make(s: *mut i64) { var t: A = A { sink: s }; }
tfn same() { var x: i64 = 1; }
