// `v[i] = x` on a Vec dispatches to setAt and skipped the assignment
// check, passing an i64 where setAt takes the u8 element.
// expect-error: type mismatch in element assignment: expected `u8`, found `u64`; use an explicit `as` cast

const { Vec } = import("collections");

fn main() {
    var v: Vec(u8) = Vec(u8).withCapacity(4);
    v.push(1);
    var big: u64 = 300;
    v[0] = big;
}
